  "scope": {
    "ja": "score-partwise の duration ÷ divisions を検査します。声部の長さは合算せず、連符比率も再適用しません。 浄書・再生・OCR・自動修復・全 XSD 検証・音楽的な正しさの判定は行いません。途中の divisions / 拍子変更、段別拍子は未対応として表示します。",
    "en": "Inspect duration ÷ divisions in score-partwise files. Voice lengths are never summed, and tuplet ratios are never applied twice. No engraving, playback, OCR, automatic repair, full XSD validation, or musical-correctness verdict. Mid-measure divisions / meter changes and staff-specific meters are marked unsupported."
  },
  "privacy": {
    "ja": "外部画像・DTD・リンクは取得しません。保存や通信は自動で行いません。ページを閉じると読み込みデータは消えます。",
    "en": "No external images, DTDs, or links are fetched. No automatic saving or data transmission. Closing the page discards imported data."
  },
  "findingDescriptions": {
    "before-zero": {
      "ja": "カーソルが小節の先頭より前に移動しました",
      "en": "The cursor moved before the start of this measure"
    },
    "underfull": {
      "ja": "符号化された最大到達位置が拍子の長さより短いです。意図した省略か確認してください",
      "en": "Encoded extent is shorter than the meter. Review whether this is intentional"
    },
    "overfull": {
      "ja": "符号化された最大到達位置が拍子の長さを超えています",
      "en": "Encoded extent is longer than the meter. Review the handoff"
    },
    "chord-too-long": {
      "ja": "和音構成音が先行する基準音より長いです",
      "en": "A chord tone lasts longer than its leading note"
    },
    "orphan-chord": {
      "ja": "対応する直前の基準音を確認できません",
      "en": "No compatible preceding leading note was found for this chord tone"
    },
    "invalid-duration": {
      "ja": "正の duration が一意に指定されていません。時間軸は確定できません",
      "en": "A single positive duration is missing or invalid; the timeline is incomplete"
    },
    "invalid-divisions": {
      "ja": "divisions が一意の正の数ではありません",
      "en": "Divisions is not a single positive number"
    },
    "missing-divisions": {
      "ja": "継承できる divisions がありません",
      "en": "No divisions value is available to inherit"
    },
    "missing-time": {
      "ja": "継承できる拍子がありません。長さの比較は行いません",
      "en": "No meter is available to inherit; extent comparison is unavailable"
    },
    "unsupported-midmeasure-divisions": {
      "ja": "途中の divisions 変更は未対応です。次の明示的な小節境界設定まで継承値を使いません",
      "en": "Mid-measure divisions changes are unsupported; inheritance stays unavailable until an explicit boundary reset"
    },
    "unsupported-midmeasure-time": {
      "ja": "途中の拍子変更は未対応です。次の明示的な小節境界設定まで拍子を比較しません",
      "en": "Mid-measure meter changes are unsupported; meter comparison waits for an explicit boundary reset"
    },
    "unsupported-inherited-divisions": {
      "ja": "以前の未対応・不正な divisions 設定が未解決です",
      "en": "An earlier unsupported or invalid divisions context remains unresolved"
    },
    "unsupported-inherited-time": {
      "ja": "以前の未対応の拍子設定が未解決です",
      "en": "An earlier unsupported meter context remains unresolved"
    },
    "unsupported-staff-time": {
      "ja": "段別の拍子は未対応です",
      "en": "Staff-specific meter is unsupported"
    },
    "unsupported-time-limit": {
      "ja": "拍子の項数または分数の複雑さが安全上の上限を超えたため、拍子比較を保留します",
      "en": "Meter pair, term, or fraction complexity exceeds the safety limit; meter comparison is withheld"
    },
    "unsupported-time": {
      "ja": "この拍子表現は未対応です（自由拍子・交換拍子・不正形式など）",
      "en": "This meter form is unsupported, including unmeasured, interchangeable, or malformed meter"
    },
    "unsupported-element": {
      "ja": "未対応の小節内要素があります。時間軸の完全性は確認できません",
      "en": "An unknown measure element prevents a complete timeline claim"
    },
    "implicit-pickup": {
      "ja": "暗黙的小節です。弱起や反復の部分小節の可能性があるため長さ比較を省略します",
      "en": "Implicit measure: extent comparison is skipped for pickup or partial-repeat context"
    },
    "non-controlling": {
      "ja": "非制御小節です。複拍子の可能性があるため長さ比較を省略します",
      "en": "Non-controlling measure: extent comparison is skipped for multimetric context"
    },
    "grace-duration": {
      "ja": "装飾音の duration は通常カーソルに適用しません。記述を確認してください",
      "en": "A grace-note duration is not applied to the ordinary cursor; review the encoding"
    },
    "empty-measure": {
      "ja": "時間イベントのない小節です",
      "en": "This measure has no timing events"
    },
    "incomplete-timeline": {
      "ja": "時間軸を一意に確定できないため集計を表示しません",
      "en": "Timeline totals are withheld because positioning is incomplete"
    },
    "ambiguous-event": {
      "ja": "時間に関する子要素が重複または矛盾しています",
      "en": "Timing-related child elements are duplicated or conflicting"
    }
  },
